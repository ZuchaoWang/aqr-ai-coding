{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OC_MAIN_MODEL}",
  "default_agent": "build",
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "agents": {
    "build": {
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "~/projects/**", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.cache/opencode/**", "effect": "allow" },
        { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
        { "action": "edit", "resource": "~/.config/opencode/**", "effect": "ask" },
        { "action": "read", "resource": "~/.local/share/opencode/**", "effect": "ask" },
        { "action": "edit", "resource": "~/.local/share/opencode/**", "effect": "ask" },
        { "action": "edit", "resource": "~/.cache/opencode/**", "effect": "ask" }
      ]
    },
    "plan": {
      "model": "{env:OC_PLAN_MODEL}",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "~/projects/**", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.cache/opencode/**", "effect": "allow" },
        { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "~/.opencode/plan/**", "effect": "allow" }
      ]
    },
    "autonomous": {
      "description": "Unattended mode: never prompts. Would-be asks resolve to deny, so it skips blocked actions and continues."
    },
    "explore": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "visual": {
      "model": "{env:OC_VISUAL_MODEL}"
    },
    "title": {
      "model": "{env:OC_SMALL_MODEL}"
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 20000
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "~/projects/**", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/projects/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "edit", "resource": "~/.config/opencode/**", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/opencode/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.cache/opencode/**", "effect": "deny" }
  ],
  "providers": {
    "ark-agent-plan": {
      "name": "Ark Agent Plan",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/plan/v3"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 200000, "output": 4096 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "glm-latest": {
          "name": "glm-latest",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "kimi-k3": {
          "name": "kimi-k3",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "ark-coding-plan": {
      "name": "Ark Coding Plan",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 200000, "output": 4096 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "glm-latest": {
          "name": "glm-latest",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        }
      }
    },
    "clinepass": {
      "name": "ClinePass",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.cline.bot/api/v1"
      },
      "models": {
        "cline-pass/kimi-k3": {
          "name": "kimi-k3",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "cline-pass/deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 200000, "output": 4096 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "cline-pass/glm-5.3": {
          "name": "glm-5.3",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "cline-pass/glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["{env:NVM_BIN}/playwright-mcp", "--headless", "--output-dir", ".playwright-mcp"],
        "disabled": false,
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 30000 }
      },
      "chrome-devtools-mcp": {
        "type": "local",
        "command": ["{env:NVM_BIN}/chrome-devtools-mcp", "--headless"],
        "disabled": false,
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 60000 }
      },
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
        "disabled": false
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/{env:FIRECRAWL_API_KEY}/v2/mcp",
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "zai-vision": {
        "type": "local",
        "command": ["{env:NVM_BIN}/zai-mcp-server"],
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 30000 },
        "environment": {
          "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
          "Z_AI_MODE": "ZAI"
        }
      },
      "zai-web-reader": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_reader/mcp",
        "headers": {
          "Authorization": "Bearer {env:Z_AI_API_KEY}"
        }
      },
      "zai-web-search": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
        "headers": {
          "Authorization": "Bearer {env:Z_AI_API_KEY}"
        }
      }
    }
  }
}
