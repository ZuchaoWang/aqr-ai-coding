{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OC_MAIN_MODEL}",
  "default_agent": "build",
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "instructions": ["~/.config/opencode/machine.md"],
  "agents": {
    "plan": {
      "model": "{env:OC_PLAN_MODEL}"
    },
    "general": {
      "model": "{env:OC_SMALL_MODEL}"
    },
    "explore": {
      "model": "{env:OC_SMALL_MODEL}"
    },
    "visual": {
      "model": "{env:OC_VISUAL_MODEL}"
    },
    "title": {
      "model": "{env:OC_SMALL_MODEL}"
    },
    "summary": {
      "model": "{env:OC_SMALL_MODEL}"
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 20000
  },
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/account.json", "effect": "deny" },
    { "action": "edit", "resource": "/*", "effect": "ask" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" }
  ],
  "providers": {
    "ark-agent-plan": {
      "name": "Ark Agent Plan",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/plan/v3"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 200000, "output": 4096 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "glm-latest": {
          "name": "glm-latest",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "kimi-k3": {
          "name": "kimi-k3",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "ark-coding-plan": {
      "name": "Ark Coding Plan",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 200000, "output": 4096 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "glm-latest": {
          "name": "glm-latest",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        }
      }
    },
    "clinepass": {
      "name": "ClinePass",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.cline.bot/api/v1"
      },
      "models": {
        "cline-pass/kimi-k3": {
          "name": "kimi-k3",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "cline-pass/deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 200000, "output": 4096 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "cline-pass/glm-5.3": {
          "name": "glm-5.3",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "cline-pass/glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "limit": { "context": 200000, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "zai-web-reader": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_reader/mcp",
        "headers": {
          "Authorization": "Bearer {env:Z_AI_API_KEY}"
        },
        "timeout": { "execution": 10000 }
      },
      "zai-web-search": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
        "headers": {
          "Authorization": "Bearer {env:Z_AI_API_KEY}"
        },
        "timeout": { "execution": 10000 }
      }
    }
  }
}
